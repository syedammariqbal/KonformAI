# ============================================================
# KonformAI — Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit the real .env file to version control.
# ============================================================

# ============================================================
# LLM Providers (free tiers)
# ============================================================
GROQ_API_KEY=your_groq_key
GOOGLE_API_KEY=your_google_key
OPENROUTER_KEY=your_openrouter_key

# ============================================================
# Global Switches
# ============================================================
GLOBAL_DRY_RUN=false
LOG_LEVEL=INFO
ENABLE_NOTIFICATIONS=true
DISCORD_WEBHOOK_URL=

# ============================================================
# LLM Model Assignments (provider:model) — one primary + two
# fallbacks per agent. Router tries primary, then fallback_1,
# then fallback_2, logging every failover.
# ============================================================

# Intake Agent — lightweight normalization, runs on every case
INTAKE_AGENT_LLM=groq:openai/gpt-oss-20b
INTAKE_AGENT_FALLBACK_1=openrouter:nvidia/nemotron-3.5-lightning:free
INTAKE_AGENT_FALLBACK_2=gemini:gemini-3.6-flash

# Injection Sanitizer Agent — fast, high-frequency, security-critical
INJECTION_SANITIZER_AGENT_LLM=gemini:gemini-3.6-flash
INJECTION_SANITIZER_AGENT_FALLBACK_1=groq:openai/gpt-oss-20b
INJECTION_SANITIZER_AGENT_FALLBACK_2=openrouter:nvidia/nemotron-3.5-lightning:free

# PII Scan Agent — thin wrapper around Presidio, low reasoning load
PII_SCAN_AGENT_LLM=groq:openai/gpt-oss-20b
PII_SCAN_AGENT_FALLBACK_1=gemini:gemini-3.6-flash
PII_SCAN_AGENT_FALLBACK_2=openrouter:nvidia/nemotron-3.5-lightning:free

# EU AI Act Classification Agent — legal-nuance judgment
EU_AI_ACT_CLASSIFIER_AGENT_LLM=openrouter:nvidia/nemotron-3-ultra-550b-a55b:free
EU_AI_ACT_CLASSIFIER_AGENT_FALLBACK_1=groq:openai/gpt-oss-120b
EU_AI_ACT_CLASSIFIER_AGENT_FALLBACK_2=gemini:gemini-3.6-flash

# BaFin Compliance Agent — legal-nuance judgment, German source material
BAFIN_COMPLIANCE_AGENT_LLM=openrouter:nvidia/nemotron-3-ultra-550b-a55b:free
BAFIN_COMPLIANCE_AGENT_FALLBACK_1=groq:openai/gpt-oss-120b
BAFIN_COMPLIANCE_AGENT_FALLBACK_2=gemini:gemini-3.6-flash

# Translation Agent — German-to-English rendering of retrieved passages
TRANSLATION_AGENT_LLM=gemini:gemini-3.6-flash
TRANSLATION_AGENT_FALLBACK_1=openrouter:nvidia/nemotron-3.5-lightning:free
TRANSLATION_AGENT_FALLBACK_2=groq:openai/gpt-oss-20b

# Conflict Resolution Agent — merges two agents' outputs
CONFLICT_RESOLUTION_AGENT_LLM=gemini:gemini-3.6-flash
CONFLICT_RESOLUTION_AGENT_FALLBACK_1=groq:openai/gpt-oss-20b
CONFLICT_RESOLUTION_AGENT_FALLBACK_2=openrouter:nvidia/nemotron-3.5-lightning:free

# Clarification Agent — asks user follow-up questions, low load
CLARIFICATION_AGENT_LLM=groq:openai/gpt-oss-20b
CLARIFICATION_AGENT_FALLBACK_1=gemini:gemini-3.6-flash
CLARIFICATION_AGENT_FALLBACK_2=openrouter:nvidia/nemotron-3.5-lightning:free

# Gap Assessment Agent — compares corpus + uploaded internal docs
GAP_ASSESSMENT_AGENT_LLM=gemini:gemini-3.6-flash
GAP_ASSESSMENT_AGENT_FALLBACK_1=openrouter:nvidia/nemotron-3.5-lightning:free
GAP_ASSESSMENT_AGENT_FALLBACK_2=groq:openai/gpt-oss-20b

# Critic/QA Agent — strongest tier, verifies citations, gates retries
CRITIC_AGENT_LLM=openrouter:nvidia/nemotron-3-ultra-550b-a55b:free
CRITIC_AGENT_FALLBACK_1=groq:openai/gpt-oss-120b
CRITIC_AGENT_FALLBACK_2=gemini:gemini-3.6-flash

# Report Agent — final plain-language drafting
REPORT_AGENT_LLM=gemini:gemini-3.6-flash
REPORT_AGENT_FALLBACK_1=groq:openai/gpt-oss-20b
REPORT_AGENT_FALLBACK_2=openrouter:nvidia/nemotron-3.5-lightning:free

# ============================================================
# Token / Context Budgets
# ============================================================
MAX_TOKENS_PER_AGENT_CALL=1024
MAX_TOOL_CALLS_PER_AGENT_RUN=12
DAILY_TOKEN_BUDGET=100000
LLM_ROUTER_MAX_CONTEXT_WARNING_PCT=0.85

# ============================================================
# LangSmith / Observability
# ============================================================
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=konformai
OTEL_EXPORTER_OTLP_ENDPOINT=

# ============================================================
# Database
# ============================================================
DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/konformai
PGVECTOR_COLLECTION=konformai_kb

# ============================================================
# Agent behavior
# ============================================================
MAX_CRITIC_RETRIES=2
CLASSIFICATION_CONFIDENCE_THRESHOLD=0.6

# ============================================================
# Security
# ============================================================
API_AUTH_TOKEN=
ALLOWED_ORIGINS=http://localhost:8501

# ============================================================
# Paths
# ============================================================
KNOWLEDGE_BASE_DIR=./knowledge_base
UPLOADED_DOCS_DIR=./knowledge_base/uploaded
